# Copy to .env for local use. .env is ignored by Git.
FLASK_ENV=development
PORT=8080

# Leave blank for a temporary local session key, or generate a stable private key:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set true only after models/rgcn_v2.pt is installed.
ENABLE_PREDICTIONS=false

# Optional: a trusted direct-download URL instead of a local checkpoint.
MODEL_URL=

# Paste your existing authorized Google Drive file URL here. The app downloads
# the prepared JSON once and caches it under backend/drugbank_data/ automatically.
# No manual file placement is required. Existing local files are reused.
DRUGBANK_JSON_URL=

# Optional source XML, unnecessary when prepared JSON is available.
DRUGBANK_XML_URL=

# Optional newer NLM RxTerms release URL; default is the pinned public release.
# After changing this, remove backend/drugbank_data/rxterms.zip to refresh names.
# RXTERMS_URL=https://data.lhncbc.nlm.nih.gov/public/rxterms/release/RxTerms202611.zip
