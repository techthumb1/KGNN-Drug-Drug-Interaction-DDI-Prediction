# Copy to .env for local use. .env is ignored by Git.
FLASK_ENV=development
PORT=8080

# Leave blank for a temporary local session key, or generate a stable private key:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set true only after models/rgcn_v2.pt is installed.
ENABLE_PREDICTIONS=false

# Optional: a trusted direct-download URL instead of a local checkpoint.
MODEL_URL=

# Optional: download an authorized prepared DrugBank JSON file at model startup.
# Local CSV/JSON files under backend/drugbank_data/ need no URL or API key.
DRUGBANK_JSON_URL=
